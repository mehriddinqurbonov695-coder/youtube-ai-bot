<!DOCTYPE html>
<html lang="uz"><head>
<meta charset="UTF-8">
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>UlugbekPardayev YouTube AI</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@800&family=Unbounded:wght@600;800&family=Manrope:wght@500;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#050405;--p:#120d0f;--l:#2b1519;--r:#ff1f3a;--r2:#a80017;--t:#f7f0f0;--m:#a08d90;--h:'Unbounded','Arial Black',sans-serif}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:Manrope,system-ui,sans-serif;background:var(--bg);color:var(--t);overflow:hidden}
body:before{content:"";position:fixed;inset:0;background:radial-gradient(90% 50% at 85% 0,#4a0712 0,transparent 70%),radial-gradient(70% 40% at 0 100%,#2e050c 0,transparent 70%);pointer-events:none}
#app{position:relative;height:100%;display:flex;flex-direction:column;padding-top:env(safe-area-inset-top,0)}
header{display:flex;align-items:center;gap:12px;padding:12px 14px}
.burger{width:46px;height:46px;border-radius:16px;background:var(--p);border:1px solid var(--l);display:grid;place-content:center;gap:5px;cursor:pointer}
.burger i{display:block;width:21px;height:3px;background:#fff;border-radius:3px}
.burger i:nth-child(2){width:13px;background:var(--r)}
.brand{font-family:var(--h);font-weight:800;font-size:15px}
.brand small{display:block;font:600 11px Manrope;color:var(--m);margin-top:2px}
.mq{overflow:hidden;white-space:nowrap}
.mq.a{background:#000;border-top:1px solid #4a1520;border-bottom:1px solid #4a1520;box-shadow:0 6px 30px rgba(255,31,58,.18)}
.sp{display:inline-block;width:10px;height:10px;margin:0 6px;background:var(--r);transform:rotate(45deg);box-shadow:0 0 12px var(--r);padding:0!important}
.mq.b{border-bottom:1px solid var(--l)}
.mq div{display:inline-block;will-change:transform}
.mq span{font-family:var(--h);font-weight:800;padding:0 22px}
.mq.a span{font-family:Orbitron,'Arial Black',sans-serif;font-weight:800;font-size:14px;line-height:40px;letter-spacing:2px;color:#fff;text-shadow:0 0 14px rgba(255,31,58,.85)}
.mq.b span{font-size:15px;line-height:38px;color:transparent;-webkit-text-stroke:1px var(--r)}
main{flex:1;position:relative;overflow:hidden}
.page{position:absolute;inset:0;overflow-y:auto;padding:16px 14px 34px;display:none}
.page.on{display:block}
#chat.on{display:flex;flex-direction:column;padding:0}
.hero{position:relative;overflow:hidden;border-radius:32px;padding:26px 22px;background:linear-gradient(150deg,#2c0810,#0d0709 70%);border:1px solid #4a1520}
.hero:after{content:"▶";position:absolute;right:-18px;top:-6px;font-size:150px;color:var(--r);opacity:.14;transform:rotate(-12deg)}
.pill{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:800;padding:6px 12px;border-radius:99px;background:#1c0d10;border:1px solid var(--l)}
.dot{width:8px;height:8px;border-radius:50%;background:#2dff7a;box-shadow:0 0 10px #2dff7a}
.hero h1{font-family:var(--h);font-size:27px;line-height:1.2;margin:16px 0 8px}
.hero h1 b{background:linear-gradient(90deg,#ff5468,var(--r));-webkit-background-clip:text;color:transparent}
.hero p{color:var(--m);font-size:14px;line-height:1.5;max-width:260px}
h2{font-family:var(--h);font-size:14px;margin:26px 4px 14px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.tile{position:relative;overflow:hidden;text-align:left;font:inherit;color:var(--t);cursor:pointer;border-radius:28px;padding:18px;background:var(--p);border:1px solid var(--l);min-height:150px;display:flex;flex-direction:column;justify-content:flex-end;transition:transform .15s}
.tile:active{transform:scale(.97)}
.tile .ic{position:absolute;left:16px;top:16px;width:50px;height:50px;border-radius:17px;display:grid;place-content:center;font-size:25px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12)}
.tile b{font-family:var(--h);font-size:14px;line-height:1.3}
.tile small{display:block;font-size:12px;color:var(--m);margin-top:5px;font-weight:600}
.tile.big{grid-column:1/-1;min-height:170px;background:linear-gradient(135deg,var(--r),var(--r2));border:0;box-shadow:0 14px 40px rgba(255,31,58,.3)}
.tile.big small{color:#ffd9de}
.tile.big:after{content:"💬";position:absolute;right:-6px;bottom:-22px;font-size:120px;opacity:.16}
.tile:not(.big):nth-child(3){background:linear-gradient(160deg,#25090e,var(--p));border-color:#4a1520}
.drawer{position:fixed;inset:0;z-index:20;visibility:hidden}
.drawer.on{visibility:visible}
.shade{position:absolute;inset:0;background:rgba(0,0,0,.65);opacity:0;transition:.25s}
.drawer.on .shade{opacity:1}
.side{position:absolute;left:0;top:0;bottom:0;width:82%;max-width:330px;background:#0a0708;border-right:1px solid #3a1a20;padding:calc(20px + env(safe-area-inset-top,0)) 16px;transform:translateX(-100%);transition:.28s;display:flex;flex-direction:column;gap:10px}
.drawer.on .side{transform:none}
.side>b{font-family:var(--h);font-size:16px;margin:4px 4px 12px}
.item{display:flex;align-items:center;gap:14px;padding:14px;border-radius:20px;background:var(--p);border:1px solid var(--l);color:var(--t);font:800 15px Manrope;cursor:pointer;width:100%;text-align:left}
.item span{width:42px;height:42px;border-radius:14px;display:grid;place-content:center;font-size:21px;background:linear-gradient(135deg,var(--r),var(--r2))}
.chead{padding:6px 16px 10px;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--l)}
.av{width:42px;height:42px;border-radius:15px;background:linear-gradient(135deg,var(--r),var(--r2));display:grid;place-content:center;font-size:20px;flex:none}
.chead b{font-family:var(--h);font-size:14px}
.chead small{display:flex;align-items:center;gap:6px;color:var(--m);font-size:12px;font-weight:700;margin-top:3px}
#msgs{flex:1;overflow-y:auto;padding:16px 14px;display:flex;flex-direction:column;gap:12px}
.m{max-width:86%;padding:13px 16px;border-radius:22px;font-size:15px;line-height:1.55;white-space:pre-wrap}
.m.u{align-self:flex-end;background:linear-gradient(135deg,var(--r),var(--r2));border-bottom-right-radius:7px}
.m.b{align-self:flex-start;background:var(--p);border:1px solid var(--l);border-bottom-left-radius:7px}
.chips{display:flex;gap:8px;overflow-x:auto;padding:0 14px 10px;scrollbar-width:none}
.chip{flex:none;padding:10px 15px;border-radius:99px;background:var(--p);border:1px solid var(--l);color:var(--t);font:700 13px Manrope;cursor:pointer}
.chip.on{background:var(--r);border-color:var(--r)}
.bar{padding:6px 12px calc(12px + env(safe-area-inset-bottom,0))}
.box{display:flex;gap:8px;align-items:center;background:#0c080a;border:1px solid #47202a;border-radius:26px;padding:6px 6px 6px 18px}
.box input{flex:1;min-width:0;background:none;border:0;outline:0;color:var(--t);font:500 15px Manrope}
.send{width:46px;height:46px;border:0;border-radius:18px;background:linear-gradient(135deg,var(--r),var(--r2));color:#fff;font-size:20px;cursor:pointer}
.card{background:var(--p);border:1px solid var(--l);border-radius:28px;padding:18px;margin-bottom:14px}
.card h3{font-family:var(--h);font-size:15px;margin-bottom:8px}
.card p{color:var(--m);font-size:14px;line-height:1.55}
.lbl{font-size:12px;font-weight:800;color:var(--m);margin:16px 2px 8px}
.row{display:flex;gap:8px;flex-wrap:wrap}
.btn{margin-top:16px;width:100%;padding:16px;border:0;border-radius:20px;background:linear-gradient(135deg,var(--r),var(--r2));color:#fff;font:800 15px Manrope;cursor:pointer;box-shadow:0 10px 30px rgba(255,31,58,.3)}
.th{position:relative;overflow:hidden;aspect-ratio:16/9;border-radius:20px;margin-top:14px;display:flex;align-items:flex-end;padding:14px;background:linear-gradient(120deg,#000,#5c0a18 60%,var(--r));border:1px solid #5a1a24}
.th:before{content:"▶";position:absolute;right:14px;top:8px;font-size:64px;color:#fff;opacity:.85}
.th b{position:relative;font-family:var(--h);font-size:20px;line-height:1.15;text-shadow:0 3px 0 #000;max-width:75%}
.ph{background:linear-gradient(140deg,#380913,#0d0709 65%);border-color:#4a1520}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:16px 0}
.stats div{background:#0c080a;border:1px solid var(--l);border-radius:20px;padding:14px 8px;text-align:center}
.stats b{display:block;font-family:var(--h);font-size:20px;color:#ff5468}
.stats small{font-size:11px;color:var(--m);font-weight:700}
.step{display:flex;gap:14px;padding:6px 0 16px;position:relative}
.step:not(:last-child):before{content:"";position:absolute;left:19px;top:44px;bottom:0;width:2px;background:var(--l)}
.step i{flex:none;width:40px;height:40px;border-radius:14px;display:grid;place-content:center;background:var(--r);font:800 15px var(--h);font-style:normal}
.step b{display:block;font-size:15px;margin-bottom:3px}
.step p{font-size:13px}

.plans{display:grid;gap:14px}
.plan{position:relative;overflow:hidden;border-radius:28px;padding:22px 20px;cursor:pointer;border:1px solid var(--l);transition:transform .15s}
.plan:active{transform:scale(.98)}
.plan .nm{font-family:var(--h);font-size:13px;letter-spacing:3px;color:var(--m)}
.plan .pr{font-family:var(--h);font-size:28px;margin:10px 0 4px}
.plan .pr small{font:700 13px Manrope;color:var(--m)}
.plan .sb{font-size:13px;color:var(--m);font-weight:600}
.plan .acts{display:none;gap:10px;margin-top:18px}
.plan.open .acts{display:flex}
.acts button{flex:1;padding:14px 8px;border-radius:18px;font:800 14px Manrope;cursor:pointer;border:0}
.acts .buy{background:#fff;color:#000}
.acts .inf{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.25)}
.bd{position:absolute;right:16px;top:16px;font-size:11px;font-weight:800;padding:6px 12px;border-radius:99px;background:rgba(255,255,255,.14)}
.plan.hup{background:linear-gradient(160deg,#1a1416,#0b0809)}
.plan.pro{background:linear-gradient(135deg,var(--r),var(--r2));border:0;box-shadow:0 14px 40px rgba(255,31,58,.3)}
.plan.pro .nm,.plan.pro .pr small,.plan.pro .sb{color:#ffe0e4}
.plan.vip{background:linear-gradient(150deg,#221a08,#050405 70%);border-color:#c9a24a;box-shadow:0 0 30px rgba(201,162,74,.18)}
.plan.vip .nm,.plan.vip .pr{color:#ecc96e}
.plan.vip .bd{background:#c9a24a;color:#000}
.sheet{position:fixed;inset:0;z-index:30;visibility:hidden}
.sheet.on{visibility:visible}
.sheet .shade{position:absolute;inset:0;background:rgba(0,0,0,.7);opacity:0;transition:.25s}
.sheet.on .shade{opacity:1}
.sbody{position:absolute;left:0;right:0;bottom:0;max-height:88%;overflow-y:auto;background:#0d090b;border-top:1px solid #4a1520;border-radius:30px 30px 0 0;padding:22px 18px calc(26px + env(safe-area-inset-bottom,0));transform:translateY(100%);transition:.3s}
.sheet.on .sbody{transform:none}
.x{float:right;width:38px;height:38px;border-radius:13px;border:1px solid var(--l);background:var(--p);color:#fff;font-size:16px;cursor:pointer}
.sbody h3{font-family:var(--h);font-size:16px;margin:4px 0 16px}
.inf4{font-family:var(--h);font-size:14px;margin:20px 0 10px;color:#ff5468}
.lines{font-size:14px;line-height:1.95;color:#eadede}
.cardn{font-family:var(--h);font-size:19px;letter-spacing:1px;background:linear-gradient(135deg,#2c0810,#0d0709);border:1px solid #4a1520;border-radius:22px;padding:22px 10px;text-align:center;margin:14px 0}
.tm{height:7px;background:var(--l);border-radius:9px;overflow:hidden;margin:16px 0 8px}
.tm i{display:block;height:100%;width:100%;background:var(--r);transition:width 1s linear}
.note{font-size:13px;color:var(--m);line-height:1.5}

.mq.c{background:linear-gradient(90deg,#1d1608,#000 50%,#1d1608);border-color:#c9a24a;box-shadow:0 6px 30px rgba(201,162,74,.18)}
.mq.c span{font-family:Unbounded,'Arial Black',sans-serif;font-weight:600;letter-spacing:1px;color:#ecc96e;text-shadow:0 0 14px rgba(201,162,74,.7)}
.mq.c .sp{background:#ecc96e;box-shadow:0 0 12px #ecc96e}
.plus{flex:none;width:42px;height:42px;border-radius:16px;border:1px solid #47202a;background:var(--p);color:#fff;font-size:24px;cursor:pointer}
.att{padding:0 14px 8px}.at{position:relative;display:inline-block}
.at img{width:72px;height:72px;object-fit:cover;border-radius:16px;border:1px solid var(--r)}
.at button{position:absolute;right:-6px;top:-6px;width:24px;height:24px;border-radius:50%;border:0;background:var(--r);color:#fff;cursor:pointer}
.pic{display:block;max-width:100%;border-radius:14px;margin-bottom:8px}
.ta{width:100%;min-height:110px;background:#0c080a;border:1px solid #47202a;border-radius:20px;padding:14px;color:var(--t);font:500 15px Manrope;outline:0;resize:none}
.pvw{margin:16px auto 0;border-radius:20px;border:1px dashed #5a2029;background:linear-gradient(135deg,#2c0810,#0a0708);display:grid;place-content:center;color:var(--m);font-size:13px;text-align:center;padding:10px;overflow:hidden;width:100%}
.sbody{left:50%!important;right:auto!important;top:50%!important;bottom:auto!important;width:90%;max-width:380px;max-height:82%;border:1px solid #4a1520;border-radius:30px!important;opacity:0;transform:translate(-50%,-46%) scale(.94)!important}
.sheet.on .sbody{opacity:1;transform:translate(-50%,-50%)!important}
.sbody.pro{border-color:var(--r)}.sbody.vip{border-color:#c9a24a}
.pr2{font-family:var(--h);font-size:26px;margin:2px 0 6px}.pr2 small{font:700 13px Manrope;color:var(--m)}
.acts2{display:flex;gap:10px;margin-top:16px}
.acts2 button{flex:1;padding:14px 8px;border-radius:18px;font:800 14px Manrope;border:0;cursor:pointer}
.acts2 .buy{background:linear-gradient(135deg,var(--r),var(--r2));color:#fff}
.acts2 .inf{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.25)}
.back{background:none;border:0;color:var(--m);font:700 14px Manrope;margin-bottom:10px;cursor:pointer}
:root{--logo:url(data:image/webp;base64,)}
.av.logo{background:var(--logo) center/cover no-repeat;border-radius:50%;box-shadow:0 0 14px rgba(255,31,58,.5)}
.tile .ic.logo{background:var(--logo) center/cover no-repeat;border:2px solid rgba(255,255,255,.35);border-radius:50%}

.hl{width:42px;height:42px;border-radius:50%;flex:none;background:var(--logo) center/cover no-repeat;box-shadow:0 0 16px rgba(255,31,58,.55)}
.hero:after{content:"";right:16px;top:auto;bottom:16px;width:92px;height:92px;border-radius:50%;font-size:0;opacity:1;transform:none;background:var(--logo) center/cover no-repeat;box-shadow:0 0 0 2px rgba(255,31,58,.5),0 0 34px rgba(255,31,58,.55);animation:fl 4s ease-in-out infinite}
.hero h1{font-size:24px}.hero p{max-width:58%}
@keyframes fl{50%{transform:translateY(-8px)}}
.tile{animation:up .55s backwards}
.tile:nth-child(2){animation-delay:.08s}.tile:nth-child(3){animation-delay:.16s}
@keyframes up{from{opacity:0;transform:translateY(16px)}}
.tile.big{min-height:196px}
.tile.big .ic{width:80px;height:80px;left:18px;top:18px;animation:pl 2.6s ease-in-out infinite}
@keyframes pl{0%,100%{box-shadow:0 0 0 0 rgba(255,255,255,.45)}50%{box-shadow:0 0 0 12px rgba(255,255,255,0)}}
.tile.big b{font-size:17px}.tile.big b:after{content:"  →"}
.tile.big:before{content:"";position:absolute;top:0;left:-60%;width:38%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.25),transparent);transform:skewX(-18deg);animation:sh 4.5s ease-in-out infinite}
@keyframes sh{0%,55%{left:-60%}100%{left:140%}}
.tile:not(.big) .ic{background:linear-gradient(135deg,var(--r),var(--r2));border:0;box-shadow:0 8px 20px rgba(255,31,58,.4)}
.tile:not(.big){border-color:#3a1a20;background:linear-gradient(165deg,#1c1013,#0d090b)}

.tile.big{background:radial-gradient(circle at 90% 100%,rgba(255,255,255,.2) 0 54px,transparent 55px),radial-gradient(circle at 90% 100%,rgba(255,255,255,.1) 0 92px,transparent 93px),linear-gradient(135deg,var(--r),var(--r2))}
.tile.big b:after{content:none}
.tile.big:after{content:"→";position:absolute;right:18px;bottom:18px;width:50px;height:50px;border-radius:50%;display:flex;align-items:center;justify-content:center;font:800 24px Manrope;color:#fff;opacity:1;background:rgba(255,255,255,.22);border:1px solid rgba(255,255,255,.45);backdrop-filter:blur(4px)}
.item span.li{background:var(--logo) center/cover no-repeat;border:1px solid rgba(255,31,58,.6)}

.tile:not(.big){animation:up .55s backwards,bd 3.6s ease-in-out infinite}
@keyframes bd{50%{border-color:rgba(255,31,58,.6);box-shadow:0 0 24px rgba(255,31,58,.22)}}
.tile:not(.big) .ic{animation:gl 2.4s ease-in-out infinite}
@keyframes gl{50%{box-shadow:0 8px 30px rgba(255,31,58,.85)}}
.tile:nth-child(2) .ic{animation:wig 3.4s ease-in-out infinite,gl 2.4s ease-in-out infinite}
@keyframes wig{0%,100%{transform:rotate(0)}25%{transform:rotate(-9deg) scale(1.06)}75%{transform:rotate(9deg) scale(1.06)}}
.tile:nth-child(3) .ic{animation:bob 2.8s ease-in-out infinite,gl 2.4s ease-in-out infinite .5s}
@keyframes bob{50%{transform:translateY(-7px)}}
.tile:not(.big):before{content:"";position:absolute;top:0;left:-60%;width:36%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.14),transparent);transform:skewX(-18deg);animation:sh 5s ease-in-out infinite}
.tile:nth-child(3):before{animation-delay:2s}
:root{--kurs:url(data:image/webp;base64,)}
.tile .ic.kc,.item span.kc{background-image:var(--kurs);background-size:210%;background-position:46% 12%;background-repeat:no-repeat;border:2px solid rgba(255,255,255,.35)}
:root{--ban:url(data:image/webp;base64,)}
.tile .ic.pi,.item span.pi{background-image:var(--ban);background-size:cover;background-position:center;background-repeat:no-repeat;border:2px solid rgba(255,255,255,.35)}

/* ===== KURS BO'LIMI ANIMATSIYALARI ===== */
@keyframes inL{from{opacity:0;transform:translateX(-60px) scale(.9)}}
@keyframes inR{from{opacity:0;transform:translateX(60px) scale(.9)}}
@keyframes fl2{50%{translate:0 -6px}}
@keyframes flow{50%{background-position:100% 0}}
@keyframes glr{50%{box-shadow:0 14px 64px rgba(255,31,58,.7)}}
@keyframes glg{50%{box-shadow:0 0 44px rgba(201,162,74,.5);border-color:#f3d680}}
@keyframes bd2{50%{border-color:#9a9a9a;box-shadow:0 0 22px rgba(255,255,255,.12)}}
@keyframes tx{to{background-position:200% 0}}
@keyframes pulse{50%{transform:scale(1.12)}}
@keyframes crown{0%,100%{transform:rotate(-8deg) translateY(0)}50%{transform:rotate(8deg) translateY(-8px)}}
@keyframes cg{50%{box-shadow:0 0 30px rgba(255,31,58,.5);border-color:var(--r)}}
@keyframes pb{0%{box-shadow:0 0 0 0 rgba(255,31,58,.65)}70%,100%{box-shadow:0 0 0 14px rgba(255,31,58,0)}}
#course h2{animation:up .6s backwards}
.plan{animation:none}
.plan.hup{animation:inL .7s cubic-bezier(.2,.9,.3,1.2) backwards,fl2 5s ease-in-out .8s infinite,bd2 3.6s ease-in-out infinite}
.plan.pro{background:linear-gradient(120deg,#ff1f3a,#ff6a78,#a80017,#ff1f3a);background-size:300% 100%;animation:inR .8s cubic-bezier(.2,.9,.3,1.2) .12s backwards,fl2 4.6s ease-in-out 1s infinite,glr 2.2s ease-in-out infinite,flow 6s ease-in-out infinite}
.plan.vip{animation:inL .9s cubic-bezier(.2,.9,.3,1.2) .24s backwards,fl2 5.4s ease-in-out 1.2s infinite,glg 2.6s ease-in-out infinite}
.plan:before{content:"";position:absolute;top:0;left:-60%;width:35%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.2),transparent);transform:skewX(-18deg);animation:sh 4.5s ease-in-out infinite}
.plan.pro:before{animation-duration:3s}.plan.vip:before{animation-delay:1.5s;background:linear-gradient(100deg,transparent,rgba(236,201,110,.3),transparent)}
.plan .pr{background:linear-gradient(90deg,#fff,#9a8f90,#fff);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:tx 3.5s linear infinite}
.plan.pro .pr{background-image:linear-gradient(90deg,#fff,#ffc2ca,#fff)}
.plan.vip .pr{background-image:linear-gradient(90deg,#ecc96e,#fff6d0,#ecc96e);color:transparent}
.plan .pr small{-webkit-text-fill-color:var(--m)}
.plan.pro .pr small{-webkit-text-fill-color:#ffe0e4}
.plan .bd{animation:pulse 1.8s ease-in-out infinite}
.plan:after{position:absolute;right:18px;bottom:14px;font-size:36px;filter:drop-shadow(0 0 10px rgba(255,255,255,.45));animation:crown 3s ease-in-out infinite}
.plan.hup:after{content:"🚀"}.plan.pro:after{content:"⚡";animation-duration:2s}.plan.vip:after{content:"👑";filter:drop-shadow(0 0 12px rgba(236,201,110,.9))}
/* ochiladigan oyna */
.sbody{transform:translate(-50%,-40%) scale(.78)!important;transition:transform .55s cubic-bezier(.34,1.56,.64,1),opacity .3s!important}
.sbody>*{animation:up .5s backwards}
.sbody>*:nth-child(2){animation-delay:.05s}.sbody>*:nth-child(3){animation-delay:.1s}.sbody>*:nth-child(4){animation-delay:.16s}.sbody>*:nth-child(5){animation-delay:.22s}
.sbody .item{animation:inR .5s backwards}.sbody .item+.item{animation-delay:.12s}
.acts2 .buy{animation:pb 2s infinite}
.acts2 button:active,.item:active{transform:scale(.96)}
.inf4{animation:inR .5s backwards}.lines{animation:up .6s .1s backwards}
.cardn{animation:cg 2s ease-in-out infinite}
.pr2{background:linear-gradient(90deg,#fff,#ff8a97,#fff);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:tx 3s linear infinite}
.pr2 small{-webkit-text-fill-color:var(--m)}
.sbody.vip .pr2{background-image:linear-gradient(90deg,#ecc96e,#fff6d0,#ecc96e)}

.plan:after,.plan.hup:after,.plan.pro:after,.plan.vip:after{content:none!important}
.pe{position:absolute;right:18px;bottom:14px;font-size:36px;filter:drop-shadow(0 0 10px rgba(255,255,255,.45));animation:crown 3s ease-in-out infinite}
.plan.blue,.plan.green,.plan.purple{animation:inL .8s cubic-bezier(.2,.9,.3,1.2) backwards,fl2 5s ease-in-out 1s infinite}
.plan.blue{background:linear-gradient(150deg,#08233f,#050405 72%);border-color:#2e8bff;box-shadow:0 0 30px rgba(46,139,255,.2)}
.plan.green{background:linear-gradient(150deg,#06281a,#050405 72%);border-color:#2fd47a;box-shadow:0 0 30px rgba(47,212,122,.2)}
.plan.purple{background:linear-gradient(150deg,#1e0f3d,#050405 72%);border-color:#9b6bff;box-shadow:0 0 30px rgba(155,107,255,.22)}
.plan.blue .nm{color:#7fbcff}.plan.green .nm{color:#7df0b0}.plan.purple .nm{color:#c4a7ff}
.plan.blue .pr{background-image:linear-gradient(90deg,#7fbcff,#fff,#7fbcff)}.plan.green .pr{background-image:linear-gradient(90deg,#7df0b0,#fff,#7df0b0)}.plan.purple .pr{background-image:linear-gradient(90deg,#c4a7ff,#fff,#c4a7ff)}
.sbody.blue{border-color:#2e8bff}.sbody.green{border-color:#2fd47a}.sbody.purple{border-color:#9b6bff}
.phead{display:flex;align-items:center;gap:12px;margin-bottom:6px}.phead h3{margin:0}
.pic2{width:52px;height:52px;border-radius:17px;display:grid;place-content:center;font-size:28px;background:linear-gradient(135deg,var(--r),var(--r2));box-shadow:0 8px 22px rgba(255,31,58,.4)}
.sum{display:flex;justify-content:space-between;align-items:center;background:#0c080a;border:1px solid var(--l);border-radius:18px;padding:14px 16px;margin-bottom:14px}.sum b{font-family:var(--h);color:#ff5468}
.pay{display:flex;align-items:center;gap:14px;width:100%;text-align:left;margin-bottom:12px;padding:14px;border-radius:22px;background:linear-gradient(160deg,#1c1013,#0d090b);border:1px solid #3a1a20;color:var(--t);cursor:pointer;font:inherit;animation:inR .5s backwards}
.pay.hot{border-color:var(--r);box-shadow:0 0 26px rgba(255,31,58,.25);animation:inR .5s .12s backwards,cg 2.2s ease-in-out infinite}
.pay i{flex:none;width:56px;height:56px;border-radius:50%;border:2px solid rgba(255,255,255,.35);background-size:cover;background-position:center}
.pay .a1{background-image:var(--kurs);background-size:210%;background-position:46% 12%}.pay .a2{background-image:var(--logo)}
.pay span b{display:block;font-size:16px}.pay span small{display:block;color:var(--m);font-size:12px;margin-top:3px;font-weight:600}
.pay:active{transform:scale(.97)}
.cpb{width:100%;padding:13px;border-radius:16px;border:1px dashed #5a2029;background:#120a0c;color:#fff;font:700 14px Manrope;cursor:pointer}
.up{display:grid;place-content:center;min-height:90px;margin:8px 0;border:2px dashed #5a2029;border-radius:20px;color:var(--m);font-weight:700;font-size:14px;text-align:center;cursor:pointer;background-size:cover;background-position:center}
.up.has{color:#fff;text-shadow:0 2px 8px #000;border-style:solid;border-color:var(--r);min-height:160px}
.chead{display:none!important}
.tile.wide{grid-column:1/-1;min-height:120px}.tile:nth-child(4){animation-delay:.24s}

.chgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding-bottom:24px}
.ch{position:relative;display:flex;border-radius:28px;overflow:hidden;padding:3px;min-height:196px;background:#2a1519;animation:up .5s backwards;cursor:pointer}
.ch.emp{background:#1f1013;cursor:default}
.ch:not(.emp):before{content:"";position:absolute;left:50%;top:50%;width:260%;aspect-ratio:1;transform:translate(-50%,-50%) rotate(0);background:conic-gradient(transparent 0 52%,rgba(255,31,58,.18) 62%,#ff1f3a 90%,#ffb3bb 100%);animation:ringspin 3s linear infinite}
@keyframes ringspin{to{transform:translate(-50%,-50%) rotate(360deg)}}
.ch .in{position:relative;flex:1;width:100%;border-radius:25px;background:linear-gradient(165deg,#1c1013,#0b0809);overflow:hidden;display:flex;flex-direction:column}
.chi{flex:1;min-height:120px;background-size:cover;background-position:center}
.chn{display:grid;place-content:center;font-size:42px;color:#ff1f3a;background:radial-gradient(circle at 50% 40%,#3a0710,#0b0809)}
.cht{padding:10px 12px;display:flex;flex-direction:column;gap:3px}.cht b{font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cht span{color:#ff5468;font-weight:800;font-size:13px}
.chimg{clear:both;display:block;width:100%;max-height:240px;object-fit:cover;border-radius:18px;margin:8px 0 12px}

.tile:nth-child(5){animation-delay:.32s}
.side{background:#000!important}
.side .item{background:#000;border:1px solid #3a1118;border-radius:22px;padding:12px 14px;position:relative;overflow:hidden;font-size:15px;box-shadow:inset 4px 0 0 #ff1f3a;transition:transform .15s,border-color .2s,box-shadow .25s}
.side .item span{box-shadow:0 0 16px rgba(255,31,58,.5)}
.side .item:after{content:"›";margin-left:auto;font-size:28px;line-height:1;color:#ff1f3a}
.side .item:before{content:"";position:absolute;top:0;left:-60%;width:30%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,31,58,.28),transparent);transform:skewX(-18deg);animation:sh 4.5s ease-in-out infinite}
.side .item:active{transform:scale(.97);border-color:#ff1f3a;box-shadow:inset 4px 0 0 #ff1f3a,0 0 24px rgba(255,31,58,.45)}
.drawer.on .side .item{animation:inR .45s backwards}
.drawer.on .side .item:nth-of-type(2){animation-delay:.05s}.drawer.on .side .item:nth-of-type(3){animation-delay:.1s}.drawer.on .side .item:nth-of-type(4){animation-delay:.15s}.drawer.on .side .item:nth-of-type(5){animation-delay:.2s}.drawer.on .side .item:nth-of-type(6){animation-delay:.25s}
.side .item:nth-of-type(2):before{animation-delay:.6s}.side .item:nth-of-type(3):before{animation-delay:1.2s}.side .item:nth-of-type(4):before{animation-delay:1.8s}.side .item:nth-of-type(5):before{animation-delay:2.4s}.side .item:nth-of-type(6):before{animation-delay:3s}
.chip{background:#000;border-color:#3a1118;transition:transform .15s,box-shadow .25s}.chip:active{transform:scale(.95);border-color:#ff1f3a;box-shadow:0 0 18px rgba(255,31,58,.4)}
.btn{box-shadow:0 0 24px rgba(255,31,58,.35)}.btn:active,.acts2 button:active,.send:active{transform:scale(.96)}
@supports not ((-webkit-background-clip:text) or (background-clip:text)){.plan .pr,.pr2{color:#fff!important;-webkit-text-fill-color:#fff!important;background:none!important}}
.galw{clear:both;position:relative;margin:8px 0 12px}
.gal{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;border-radius:18px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.gal::-webkit-scrollbar{display:none}
.gal img{flex:0 0 100%;width:100%;max-height:260px;object-fit:cover;scroll-snap-align:center;display:block}
.galn{position:absolute;right:10px;top:10px;background:rgba(0,0,0,.65);border-radius:99px;padding:3px 10px;font-size:12px;font-weight:800}
.dots{display:flex;justify-content:center;gap:6px;margin-top:8px}.dots i{width:7px;height:7px;border-radius:50%;background:#3a1a20;transition:.2s}.dots i.on{background:#ff1f3a;box-shadow:0 0 8px #ff1f3a}
.cnt{position:absolute;right:8px;top:8px;background:rgba(0,0,0,.7);border-radius:99px;padding:2px 8px;font-size:11px;font-weight:800;z-index:2}
.mdl{display:flex;gap:8px;padding:0 12px 8px}
.mb{flex:1;min-width:0;padding:9px 11px;border-radius:16px;background:#000;border:1px solid #3a1118;color:#fff;text-align:left;font:inherit;cursor:pointer;transition:transform .15s,box-shadow .25s,border-color .2s}
.mb b{display:block;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mb small{display:block;font-size:11px;color:var(--m);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mb.on{background:linear-gradient(135deg,var(--r),var(--r2));border-color:var(--r);box-shadow:0 0 18px rgba(255,31,58,.4)}.mb.on small{color:#ffe0e4}
.mb:active{transform:scale(.97)}
.by{display:block;margin-top:8px;font-size:11px;color:var(--m)}
:root{--market:url(data:image/webp;base64,)}
.tile.wide{flex-direction:row;align-items:center;justify-content:flex-start;gap:16px;min-height:104px;padding:14px 18px}
.tile.wide .ic{position:static;flex:none;width:68px;height:68px}
.tile.wide .tx{display:block;min-width:0;text-align:left}
.tile.wide.mkt{min-height:136px}
.tile.wide .ic.mk{width:100px;height:100px}
.tile .ic.mk{background-image:var(--market);background-size:cover;background-position:center;border:2px solid rgba(255,255,255,.35);border-radius:50%}
.item span.mk{background-image:var(--market);background-size:cover;background-position:center;border:1px solid rgba(255,31,58,.6)}
.pm{position:absolute;left:12px;right:12px;bottom:92px;z-index:6;flex-direction:column;gap:8px;padding:10px;border-radius:24px;background:#000;border:1px solid #3a1118;box-shadow:0 0 30px rgba(255,31,58,.25)}
.pi{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:10px 12px;border-radius:18px;background:#0b0809;border:1px solid #2b1519;color:#fff;font:inherit;cursor:pointer;animation:inR .3s backwards}
.pi i{flex:none;width:42px;height:42px;border-radius:14px;display:grid;place-content:center;font-style:normal;font-size:21px;background:linear-gradient(135deg,var(--r),var(--r2))}
.pi span{flex:1;min-width:0}.pi b{display:block;font-size:14px}.pi small{display:block;color:var(--m);font-size:11px;margin-top:2px}
.pi em{font-style:normal;color:#ff5468;font-size:20px;font-weight:800}
.pi.on{border-color:var(--r);box-shadow:0 0 16px rgba(255,31,58,.35)}
.pi:nth-child(2){animation-delay:.05s}.pi:nth-child(3){animation-delay:.1s}.pi:nth-child(4){animation-delay:.15s}
.sysnote{align-self:center;background:#120d0f;border:1px solid #3a1118;border-radius:99px;padding:5px 14px;font-size:12px;color:var(--m)}
.ares{white-space:pre-wrap;margin-top:14px;font-size:14px;line-height:1.65;color:#eadede}
.tile:nth-child(6){animation-delay:.4s}
.pi.soon{opacity:.55}
:root{--video:url(data:image/webp;base64,)}
.tile .ic.vd{background-image:var(--video);background-size:cover;background-position:center;border:0;box-shadow:0 8px 26px rgba(255,31,58,.5)}
.tile.wide .ic.vd{width:88px;height:88px;border-radius:24px}
.item span.vd{background-image:var(--video);background-size:cover;background-position:center;border:1px solid rgba(255,31,58,.6)}
:root{--anl:url(data:image/webp;base64,)}
.tile .ic.an{background-image:var(--anl);background-size:cover;background-position:center;border:0;box-shadow:0 8px 26px rgba(255,31,58,.5)}
.tile.wide .ic.an{width:96px;height:96px;border-radius:24px}
.item span.an{background-image:var(--anl);background-size:cover;background-position:center;border:1px solid rgba(255,31,58,.6)}
.tile:not(.big){background:radial-gradient(circle at 100% 0,rgba(255,31,58,.16),transparent 55%),linear-gradient(160deg,#2a0b11,#12090b 60%,#0b0708);border-color:#4a1520}
.tile:not(.big):before{width:70px;background:linear-gradient(100deg,transparent,rgba(255,60,80,.16),transparent);animation:sh2 7s ease-in-out infinite}
@keyframes sh2{0%,60%{left:-90px}100%{left:calc(100% + 40px)}}
.tile:nth-child(2):before{animation-delay:.8s}.tile:nth-child(3):before{animation-delay:1.8s}.tile:nth-child(4):before{animation-delay:2.8s}.tile:nth-child(5):before{animation-delay:3.8s}.tile:nth-child(6):before{animation-delay:4.8s}
</style></head>
<body>
<div id="app">
  <header>
    <div class="burger" onclick="drawer(true)"><i></i><i></i><i></i></div>
    <div class="hl"></div><div class="brand">YouTube AI<small>UlugbekPardayev</small></div>
  </header>
  <div class="mq a" id="mqb"><div id="m1"></div></div>

  <main>
    <section class="page on" id="home">
      <div class="hero">
        <span class="pill"><i class="dot"></i>Online</span>
        <h1>Assalomu alaykum 👋<br><b>YouTube AI</b></h1>
        <p>YouTube bo'yicha hamma savolingizga tez javob beraman.</p>
      </div>
      <h2>Nimadan foydalanmoqchisiz?</h2>
      <div class="grid">
        <button class="tile big" onclick="go('chat')"><span class="ic logo"></span><b>Chat botga o'tish</b><small>Savol bering, AI javob beradi</small></button>
        <button class="tile" onclick="go('img')"><span class="ic pi"></span><b>Rasm yaratish</b><small>Video preview</small></button>
        <button class="tile" onclick="go('course')"><span class="ic kc"></span><b>Kurs haqida</b><small>UlugbekPardayev</small></button>
        <button class="tile wide mkt" onclick="go('chan')"><span class="ic mk"></span><span class="tx"><b>YouTube kanal sotib olish</b><small>Tayyor kanallar</small></span></button>
        <button class="tile wide" onclick="go('video')"><span class="ic vd"></span><span class="tx"><b>Video sotib olish</b><small>Tayyor videolar</small></span></button>
        <button class="tile wide" onclick="go('anl')"><span class="ic an"></span><span class="tx"><b>Kanalni tahlil qildirish</b><small>YouTube AI Plus</small></span></button>
      </div>
    </section>

    <section class="page" id="chat">
      <div class="chead"><div class="av logo"></div><div><b>YouTube AI</b><small><i class="dot"></i>Tez javob beradi</small></div></div>
      <div id="msgs"></div>
      <div class="chips">
        <button class="chip" onclick="ask(this.textContent)">Kanal nomi g'oyasi</button>
        <button class="chip" onclick="ask(this.textContent)">Video sarlavha yozish</button>
        <button class="chip" onclick="ask(this.textContent)">Qanday daromad olaman?</button>
        <button class="chip" onclick="ask(this.textContent)">SEO teglar</button>
      </div>
      <div class="pm" id="pm" style="display:none"></div>
      <div class="att" id="att"></div>
      <div class="bar"><div class="box" style="padding-left:6px"><button class="plus" onclick="togglePlus(event)">+</button><input type="file" id="fi" accept="image/*" hidden onchange="pickImg(this)"><input id="q1" placeholder="Savol yozing..." onkeydown="if(event.key==='Enter')send()"><button class="send" onclick="send()">➤</button></div></div>
    </section>

    <section class="page" id="img">
      <div class="card ph">
        <span class="pill">🍌 Nano Banana</span>
        <h3 style="margin-top:14px">Rasm yaratish</h3>
        <div class="lbl">Prompt</div>
        <textarea class="ta" id="pm" placeholder="Qanday rasm kerak? Batafsil yozing..."></textarea>
        <div class="lbl">Rasm hajmi</div>
        <div class="row" id="rt">
          <button class="chip on" onclick="ratio(this,'16:9')">YouTube 16:9</button>
          <button class="chip" onclick="ratio(this,'1:1')">1:1</button>
          <button class="chip" onclick="ratio(this,'9:16')">9:16</button>
          <button class="chip" onclick="ratio(this,'4:3')">4:3</button>
          <button class="chip" onclick="ratio(this,'3:4')">3:4</button>
        </div>
        <div class="pvw" id="pv" style="aspect-ratio:16/9">Natija shu yerda chiqadi</div>
        <button class="btn" onclick="gen()">Rasm yaratish</button>
      </div>
    </section>

    <section class="page" id="course">
<h2 style="margin-top:6px">Kursni tanlang</h2>
<div class="plans" id="plans"></div>
</section>
  <section class="page" id="chan"><h2 style="margin-top:6px">YouTube kanal sotib olish</h2><div class="chgrid" id="chgrid"></div></section>
  <section class="page" id="anl"><h2 style="margin-top:6px">Kanalni tahlil qildirish</h2><div class="card ph"><span class="pill">⚡ YouTube AI Plus · <span id="aqt">kuniga 10 ta</span></span><p style="margin-top:12px">YouTube kanal yoki video havolasini yuboring. AI uni tahlil qilib, kuchli-kuchsiz tomonlarini va aniq tavsiyalarni beradi.</p><div class="lbl">Havola</div><div class="box"><input id="alink" placeholder="https://youtube.com/@kanal yoki video havolasi"></div><div class="lbl">Qo‘shimcha izoh (ixtiyoriy)</div><textarea class="ta" id="anote" placeholder="Masalan: kanalim o‘yin haqida, maqsad: obunachini ko‘paytirish"></textarea><button class="btn" id="abtn" onclick="analyze()">📊 Tahlil qilish</button><div class="ares" id="ares"></div></div></section>
  <section class="page" id="video"><h2 style="margin-top:6px">Video sotib olish</h2><div class="chgrid" id="vdgrid"></div></section>
  </main>
</div>

<div class="drawer" id="dr">
  <div class="shade" onclick="drawer(false)"></div>
  <nav class="side">
    <b>Bo'limlar</b>
    <button class="item" onclick="go('chat')"><span class="li"></span>Chat bot</button>
    <button class="item" onclick="go('img')"><span class="pi"></span>Rasm yaratish</button>
    <button class="item" onclick="go('course')"><span class="kc"></span>Kurs haqida ma'lumot</button>
    <button class="item" onclick="go('chan')"><span class="mk"></span>YouTube kanal sotib olish</button>
    <button class="item" onclick="go('video')"><span class="vd"></span>Video sotib olish</button>
    <button class="item" onclick="go('anl')"><span class="an"></span>Kanalni tahlil qildirish</button>
    <button class="item" onclick="go('home')"><span class="li"></span>Bosh sahifa</button>
  </nav>
</div>

<div class="sheet" id="sh"><div class="shade" onclick="closeS()"></div><div class="sbody" id="sb"></div></div>
<script>
const $=id=>document.getElementById(id);
var MODEL=(function(){try{return localStorage.getItem('aimodel')||'plus'}catch(e){return 'plus'}})(),MODELS_UI=[{id:'plus',name:'YouTube AI Plus',icon:'⚡',limit:0,left:null},{id:'pro',name:'YouTube AI Pro',icon:'💎',limit:0,left:null,soon:true}],LASTBY='';
function drawer(o){$('dr').classList.toggle('on',o)}
const MQ={home:['UlugbekPardayev YOUTUBE AI Chat bot','a'],img:[null],chat:[null],course:['Ulugʻbek Pardayev Kurslari','a c'],chan:[null],video:[null],anl:[null]};
function go(p){document.querySelectorAll('.page').forEach(x=>x.classList.remove('on'));$(p).classList.add('on');drawer(false);
  if(p==='chat'&&!$('msgs').children.length)GREET=add('b',greetText());
  mq(MQ[p][0],MQ[p][1]);if(p==='course')countUp();if(p==='chan'||p==='video')loadChannels();if(p==='chat'||p==='anl')loadModels()}
function add(t,x,img){const d=document.createElement('div');d.className='m '+t;if(img){const i=document.createElement('img');i.src=img;i.className='pic';d.appendChild(i)}const sp=document.createElement('span');sp.textContent=x;d.appendChild(sp);$('msgs').appendChild(d);$('msgs').scrollTop=1e9;return sp}
const HD={'Content-Type':'application/json'};
async function reply(text,img){try{const r=await fetch('/api/chat',{method:'POST',headers:HD,body:JSON.stringify({message:text||'Bu rasmni tahlil qil',image:img||null,uid:UID,model:MODEL,hist:HIST.slice(-8)})});if(!r.ok)throw 0;const j=await r.json();if(j.models){MODELS_UI=j.models;renderModels()}HIST.push({role:'user',content:text||'[rasm]'},{role:'assistant',content:j.reply});LASTBY=j.by||'';return j.reply}
  catch(e){LASTBY='';return 'Demo rejim: AI serveri hali ulanmagan. Savolingiz: "'+text+'"'}}
async function ask(t,img){add('u',t,img);const w=add('b','...');const x=await reply(t,img);w.textContent=x;if(LASTBY)w.parentNode.insertAdjacentHTML('beforeend','<small class="by">'+esc(LASTBY)+'</small>')}
let IMG=null;
function pickImg(i){const f=i.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{IMG=r.result;$('att').innerHTML='<div class="at"><img src="'+IMG+'"><button onclick="rmImg()">✕</button></div>'};r.readAsDataURL(f);i.value=''}
function rmImg(){IMG=null;$('att').innerHTML=''}
function send(){const v=$('q1').value.trim();if(!v&&!IMG)return;const im=IMG;$('q1').value='';rmImg();ask(v,im)}
let RT='16:9';
function ratio(b,r){document.querySelectorAll('#rt .chip').forEach(x=>x.classList.remove('on'));b.classList.add('on');RT=r;const p=$('pv'),q=r.split(':').map(Number);p.style.aspectRatio=q[0]+'/'+q[1];p.style.width=q[0]<q[1]?'56%':'100%'}
async function gen(){const p=$('pm').value.trim(),v=$('pv');if(!p){v.textContent='Avval prompt yozing';return}v.textContent='Yaratilmoqda...';
  try{const r=await fetch('/api/image',{method:'POST',headers:HD,body:JSON.stringify({prompt:p,ratio:RT})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'xato');v.innerHTML='<img src="'+d.image+'" style="width:100%;height:100%;object-fit:cover">'}
  catch(e){v.textContent=(e&&e.message&&e.message!=='Failed to fetch')?'⚠️ '+e.message.slice(0,240):'Server bilan aloqa yo‘q.'}}
let RAF;
function mq(txt,cls){const b=$('mqb'),el=$('m1');cancelAnimationFrame(RAF);if(!txt){b.style.display='none';return}b.className='mq '+cls;b.style.display='';
  el.innerHTML=(`<span>${txt}</span><span class="sp"></span>`).repeat(10);const w=el.scrollWidth/2;let x=0,last=0;
  function f(t){const dt=last?t-last:16;last=t;x-=90*dt/1000;if(x<=-w)x+=w;el.style.transform=`translateX(${x}px)`;RAF=requestAnimationFrame(f)}RAF=requestAnimationFrame(f)}
window.addEventListener('load',()=>{const pg=document.querySelector('.page.on').id;mq(MQ[pg][0],MQ[pg][1])});

let T,CUR='';
const PL={hup:['HUP','99 000','Boshlash uchun'],pro:['PRO','855 000','Umrbod kurs + yopiq guruh'],vip:['VIP','3 200 000','To‘liq imkoniyat']};
let CARD='5614 6814 0659 1283',ADMIN='UlugbekPardayevYT1';
const L=(e,a)=>a.map(x=>e+' '+x).join('<br>');
const PRO_INFO='<div class="inf4">8️⃣ BO‘LIM — BeamNG.drive To‘liq O‘rganish</div><div class="lines">'+L('🚗',['BeamNG.drive bilan tanishuv','BeamNG.drive klaviatura boshqaruvi','BeamNG.drive 3D modellar va mod turlari','BeamNG.drive mod qanday olib kiriladi','BeamNG.drive 3D modellarni o‘rnatish','BeamNG.drive sozlamalari','BeamNG.drive F11 World Editor bilan ishlash','BeamNG.drive Like’dan foydalanish','BeamNG.drive yo‘nalishida YouTube kanal ochish'])+'</div>'
+'<div class="inf4">9️⃣ BO‘LIM — Minecraft To‘liq O‘rganish</div><div class="lines">'+L('⛏️',['Minecraft ro‘yxatdan o‘tish','Minecraft modlar o‘rnatish','Minecraft sozlamalari','Minecraft Shaders o‘rnatish','Minecraft sovg‘a kartalarini faollashtirish','Minecraft Resource Pack kiritish','Minecraft Skin qo‘shish','Minecraft Command Block va Console bilan to‘liq ishlash','Minecraft klaviatura Shortcut’lari bilan ishlash','Mob Battle yo‘nalishi','Immortal yo‘nalishida video tayyorlash','MCreator yaratish va NPC tayyorlash'])+'</div>'
+'<div class="inf4">💎 Hammasi bitta kursda — umrbod dastur</div><div class="lines">'+L('✅',['100+ video dars','Doimiy yangilanib boradigan kurs','Trend yo‘nalishlar','Telefon orqali sodda tushuntirish','Har bir dars alohida mavzu bo‘yicha','Yangi darsliklar bepul qo‘shib boriladi','Yopiq Telegram guruhiga kirish','Umrbod yangilanishlar'])+'</div>'
+'<div class="inf4">💳 Kurs narxi: 855 000 so‘m</div><div class="lines">1 martalik to‘lov<br>🎁 Umrbod kurs + yopiq guruhga kirish</div>';

let PLANS=[{id:'free',name:'BEPUL',price:'Bepul',sub:'Tekin dars',info:'',design:'green',icon:'🎁',badge:'Tekin',link:'https://t.me/tekindarsyoutube/14'},{id:'hup',name:'HUP',price:'99 000',sub:'Boshlash uchun',info:'',design:'silver',icon:'🚀',badge:''},{id:'pro',name:'PRO',price:'855 000',sub:'Umrbod kurs + yopiq guruh',info:'',design:'red',icon:'⚡',badge:'Mashhur'},{id:'vip',name:'VIP',price:'3 200 000',sub:'To‘liq imkoniyat',info:'',design:'gold',icon:'👑',badge:'Premium'}],CURID='',RCP=null;
const DZ={silver:'hup',red:'pro',gold:'vip',blue:'blue',green:'green',purple:'purple'};
function renderPlans(){$('plans').innerHTML=PLANS.map(p=>'<div class="plan '+(DZ[p.design]||'hup')+'" onclick="openPlan(\''+esc(p.id)+'\')">'+(p.badge?'<span class="bd">'+esc(p.badge)+'</span>':'')+'<div class="nm">'+esc(p.name)+'</div><div class="pr">'+esc(p.price)+(/\d/.test(p.price)?' <small>so\'m</small>':'')+'</div><div class="sb">'+esc(p.sub)+'</div><span class="pe">'+esc(p.icon||'⭐')+'</span></div>').join('')}
function planOf(id){if(String(id).startsWith('ch')){const c=(CHANNELS.concat(VIDEOS)).find(x=>'ch'+x.id===id)||{};return {id,name:(c.kind==='video'?'Video: ':'Kanal: ')+(c.title||(c.descr||'').slice(0,18)||'YouTube'),price:c.price||'',sub:'',design:'red',icon:'📺'}}return PLANS.find(p=>p.id===id)||PLANS[0]}
function sheet(h){clearInterval(T);$('sb').className='sbody '+CUR;$('sb').innerHTML='<button class="x" onclick="closeS()">✕</button>'+h;$('sh').classList.add('on')}
function closeS(){clearInterval(T);$('sh').classList.remove('on')}
function openPlan(id){const p=planOf(id);CURID=p.id;CUR=DZ[p.design]||'';sheet('<div class="phead"><span class="pic2">'+esc(p.icon||'⭐')+'</span><div><h3>'+esc(p.name)+(p.link?'':' kursi')+'</h3><p class="note">'+esc(p.sub)+'</p></div></div><div class="pr2">'+esc(p.price)+(/\d/.test(p.price)?' <small>so‘m</small>':'')+'</div><div class="acts2">'+(p.link?'<button class="buy" onclick="openLink()">Olish</button>':'<button class="buy" onclick="buy()">Sotib olish</button>')+'<button class="inf" onclick="info()">Ma‘lumot olish</button></div><div id="ib"></div>')}
function openLink(){const u=planOf(CURID).link;try{TGW.openTelegramLink(u)}catch(e){window.open(u,'_blank')}}
function info(){const p=planOf(CURID),e=$('ib');e.innerHTML=e.innerHTML?'':(p.info?'<div class="lines" style="white-space:pre-line;margin-top:14px">'+esc(p.info)+'</div>':p.id==='pro'?PRO_INFO:'<p class="note" style="margin-top:14px">Ma’lumot tez orada qo‘shiladi.</p>')}
function buy(){const p=planOf(CURID);sheet('<button class="back" onclick="goBack()">← Orqaga</button><h3>To‘lov usuli</h3><div class="sum"><span>'+esc(p.name)+'</span><b>'+esc(p.price)+' so‘m</b></div><button class="pay" onclick="toAdmin()"><i class="a1"></i><span><b>Admin orqali to‘lash</b><small>Telegramda adminga yozasiz</small></span></button><button class="pay hot" onclick="auto()"><i class="a2"></i><span><b>Avto to‘lash</b><small>Karta + chek yuborish · 10 daqiqa</small></span></button>')}
function toAdmin(){const p=planOf(CURID),k=String(CURID).startsWith('ch'),t='Assalomu alaykum 👋\n'+p.name+(k?' haqida yozyapman':' kursini tanladim')+(p.price?' ('+p.price+' so‘m)':'')+'.'+(k?'':'\nKarta: '+CARD),u='https://t.me/'+ADMIN+'?text='+encodeURIComponent(t);try{TGW.openTelegramLink(u)}catch(e){window.open(u,'_blank')}}
function auto(){const p=planOf(CURID);RCP=null;let n=600;sheet('<button class="back" onclick="buy()">← Orqaga</button><h3>Avto to‘lash</h3><div class="sum"><span>'+esc(p.name)+'</span><b>'+esc(p.price)+' so‘m</b></div><p class="note">1. To‘lovni shu kartaga o‘tkazing:</p><div class="cardn">'+CARD+(HOLDER?'<br><small style="font:600 13px Manrope;color:#a08d90">'+esc(HOLDER)+'</small>':'')+'</div><button class="cpb" onclick="cp()">📋 Kartani nusxalash</button><div class="tm"><i id="tb2"></i></div><p class="note" id="tn">Qolgan vaqt: 10:00</p><p class="note">2. To‘lov chekini (skrinshot) yuklang:</p><label class="up" id="upl"><input type="file" accept="image/*" hidden onchange="rcp(this)"><span id="upt">🖼️ Galereyadan chek tanlash</span></label><button class="btn" id="sbm" onclick="sendRcp()" disabled style="opacity:.5">Adminga yuborish</button>');
  T=setInterval(()=>{n--;$('tb2').style.width=(n/6)+'%';$('tn').textContent='Qolgan vaqt: '+String(Math.floor(n/60)).padStart(2,'0')+':'+String(n%60).padStart(2,'0');if(n<=0){clearInterval(T);sheet('<h3>⏰ Vaqt tugadi</h3><p class="note">10 daqiqa o‘tdi. Iltimos, qaytadan boshlang.</p><button class="btn" onclick="auto()">Qayta boshlash</button>')}},1000)}
function cp(){try{navigator.clipboard.writeText(CARD.replace(/ /g,''))}catch(e){}const b=document.querySelector('.cpb');if(b)b.textContent='✅ Nusxalandi'}
function rcp(i){const f=i.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const k=Math.min(1,1280/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);RCP=c.toDataURL('image/jpeg',.72);$('upl').style.backgroundImage='url('+RCP+')';$('upl').classList.add('has');$('upt').textContent='✅ Chek tanlandi (almashtirish uchun bosing)';$('sbm').disabled=false;$('sbm').style.opacity=1};im.src=r.result};r.readAsDataURL(f);i.value=''}
async function sendRcp(){clearInterval(T);const p=planOf(CURID);$('sbm').textContent='Yuborilmoqda...';let ok=false;
  try{const r=await fetch('/api/order',{method:'POST',headers:HD,body:JSON.stringify({plan:p.name,price:p.price,uid:UID,receipt:RCP})});ok=r.ok}catch(e){}
  sheet(ok?'<h3>✅ Yuborildi</h3><p class="note">Chekingiz adminga yuborildi. Admin tasdiqlasa, sizga bot orqali xabar keladi.</p><button class="btn" onclick="closeS()">Yaxshi</button>':'<h3>Yuborilmadi</h3><p class="note">Server bilan aloqa yo‘q yoki internet uzildi. Qayta urinib ko‘ring yoki “Admin orqali to‘lash” dan foydalaning.</p><button class="btn" onclick="buy()">Orqaga</button>')}

const esc=t=>String(t).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const TGW=window.Telegram&&Telegram.WebApp,INIT=(TGW&&TGW.initData)||'';HD['X-Init']=INIT;
try{if(TGW){TGW.ready();TGW.expand();TGW.setHeaderColor('#050405');TGW.setBackgroundColor('#050405')}}catch(e){}
const P0=new URLSearchParams(location.search).get('p');if(P0&&MQ[P0])go(P0);
let HIST=[],HOLDER='',INFO={hup:'',pro:'',vip:''},UID='';
try{UID=localStorage.uid||(localStorage.uid=Math.random().toString(36).slice(2)+Date.now().toString(36))}catch(e){UID=Math.random().toString(36).slice(2)}
if(TGW&&TGW.initDataUnsafe&&TGW.initDataUnsafe.user)UID=String(TGW.initDataUnsafe.user.id);
function hit(){fetch('/api/hit',{method:'POST',headers:HD,body:JSON.stringify({uid:UID})}).catch(()=>{})}
async function loadCfg(){try{const r=await fetch('/api/config');if(!r.ok)return;const c=await r.json();
  MQ.home[0]=c.mq_home;MQ.course[0]=c.mq_course;CARD=c.card;HOLDER=c.holder||'';applyImgs(c.imgs);
  if(Array.isArray(c.plans)&&c.plans.length){PLANS=c.plans;renderPlans()}
  const pg=document.querySelector('.page.on').id;mq(MQ[pg][0],MQ[pg][1]);if(pg==='course')countUp()}catch(e){}}
renderPlans();
hit();setInterval(hit,30000);loadCfg();loadChannels();loadModels();

function countUp(){}

async function forget(){try{await fetch('/api/forget',{method:'POST',headers:HD,body:JSON.stringify({uid:UID})})}catch(e){}HIST=[];$('msgs').innerHTML='';drawer(false);go('chat')}

let CHANNELS=[],VIDEOS=[];
function goBack(){String(CURID).startsWith('ch')?openChannel(+String(CURID).slice(2)):openPlan(CURID)}
async function loadChannels(){for(const k of ['channel','video']){try{const r=await fetch('/api/channels?kind='+k+'&t='+Date.now());if(r.ok){const j=await r.json();if(k==='video')VIDEOS=j;else CHANNELS=j}}catch(e){}}renderChannels()}
function grid(list,id){const g=$(id);if(!g)return;const n=Math.max(5,list.length);let o='';
  for(let i=0;i<n;i++){const c=list[i];
    o+=c?'<div class="ch" onclick="openChannel('+c.id+')"><div class="in">'+((c.imgs||[]).length>1?'<span class="cnt">📷 '+c.imgs.length+'</span>':'')+(c.img?'<div class="chi" style="background-image:url('+esc(c.img)+')"></div>':'<div class="chi chn">'+(c.kind==='video'?'🎬':'▶')+'</div>')+'<div class="cht"><b>'+esc(c.title||(c.descr||'').slice(0,24)||(c.kind==='video'?'Video':'Kanal'))+'</b>'+(c.price?'<span>'+esc(c.price)+' so‘m</span>':'')+'</div></div></div>':'<div class="ch emp"><div class="in"></div></div>'}
  g.innerHTML=o}
function renderChannels(){grid(CHANNELS,'chgrid');grid(VIDEOS,'vdgrid')}
function gal(c){const im=c.imgs&&c.imgs.length?c.imgs:(c.img?[c.img]:[]);if(!im.length)return '';
  return '<div class="galw"><div class="gal" onscroll="galS(this)">'+im.map(u=>'<img src="'+esc(u)+'">').join('')+'</div>'+(im.length>1?'<span class="galn">1/'+im.length+'</span><div class="dots">'+im.map((_,i)=>'<i'+(i?'':' class="on"')+'></i>').join('')+'</div>':'')+'</div>'}
function galS(g){const i=Math.round(g.scrollLeft/g.clientWidth),w=g.parentNode,n=w.querySelector('.galn');if(n)n.textContent=(i+1)+'/'+g.children.length;w.querySelectorAll('.dots i').forEach((d,k)=>d.classList.toggle('on',k===i))}
function openChannel(id){const c=CHANNELS.concat(VIDEOS).find(x=>x.id===id);if(!c)return;CURID='ch'+id;CUR='pro';
  sheet(gal(c)+'<h3>'+esc(c.title||(c.kind==='video'?'Video':'YouTube kanal'))+'</h3>'+(c.descr?'<div class="lines" style="white-space:pre-line">'+esc(c.descr)+'</div>':'')+(c.price?'<div class="pr2" style="margin-top:14px">'+esc(c.price)+' <small>so‘m</small></div>':'')+'<div class="acts2">'+(c.price?'<button class="buy" onclick="buy()">Sotib olish</button>':'')+'<button class="inf" onclick="toAdmin()">Admin bilan bog‘lanish</button></div>')}

var GREET=null,PMOPEN=false;
function curModel(){return MODELS_UI.find(m=>m.id===MODEL)||MODELS_UI[0]||{id:'plus',name:'YouTube AI Plus',icon:'⚡'}}
function greetText(){return 'Assalomu alaykum 👋 Men '+curModel().name+'. Savolingizni yozing.'}
function subm(m){return m.soon?'Tez orada':(m.limit?('kuniga '+m.limit+' ta · '+m.left+' qoldi'):'cheklovsiz')}
function renderModels(){const q=$('q1');if(q)q.placeholder=curModel().icon+' '+curModel().name+' ga savol yozing...';renderPlus();aq()}
function renderPlus(){const e=$('pm');if(!e)return;e.innerHTML='<button class="pi" onclick="closePlus();$(\'fi\').click()"><i>🖼️</i><span><b>Galereyadan rasm</b><small>Rasm yuborish</small></span></button>'+MODELS_UI.map(m=>'<button class="pi'+(m.id===MODEL?' on':'')+(m.soon?' soon':'')+'" onclick="pickModel(\''+m.id+'\')"><i>'+esc(m.icon)+'</i><span><b>'+esc(m.name)+'</b><small>'+esc(subm(m))+'</small></span><em>'+(m.id===MODEL?'✓':'')+'</em></button>').join('')+'<button class="pi" onclick="closePlus();go(\'anl\')"><i>📊</i><span><b>Kanalni tahlil qildirish</b><small>YouTube AI Plus bilan</small></span></button>'}
function aq(){const p=MODELS_UI.find(m=>m.id==='plus');if(p&&$('aqt'))$('aqt').textContent=subm(p)}
function togglePlus(ev){if(ev)ev.stopPropagation();PMOPEN=!PMOPEN;$('pm').style.display=PMOPEN?'flex':'none'}
function closePlus(){PMOPEN=false;const e=$('pm');if(e)e.style.display='none'}
document.addEventListener('click',e=>{if(PMOPEN&&!e.target.closest('#pm'))closePlus()});
function soonNote(){const b=$('msgs');if(!b)return;const n=document.createElement('div');n.className='sysnote';n.textContent='💎 YouTube AI Pro tez orada ishga tushadi';b.appendChild(n);b.scrollTop=1e9}
function pickModel(id){closePlus();const mm=MODELS_UI.find(x=>x.id===id);if(mm&&mm.soon){soonNote();return}if(id===MODEL)return;MODEL=id;try{localStorage.setItem('aimodel',id)}catch(e){}renderModels();
  const box=$('msgs');if(GREET&&box.children.length===1){GREET.textContent=greetText()}else{const n=document.createElement('div');n.className='sysnote';n.textContent=curModel().icon+' '+curModel().name+' tanlandi';box.appendChild(n);box.scrollTop=1e9}}
async function loadModels(){try{const r=await fetch('/api/models?uid='+encodeURIComponent(UID)+'&t='+Date.now(),{headers:HD});if(r.ok){MODELS_UI=await r.json();if(!MODELS_UI.some(m=>m.id===MODEL&&!m.soon))MODEL='plus'}}catch(e){}renderModels()}
async function analyze(){const u=$('alink').value.trim();if(!u){$('ares').textContent='Avval havolani yozing';return}
  const b=$('abtn');b.disabled=true;b.textContent='Tahlil qilinmoqda... (1 daqiqagacha)';$('ares').textContent='';
  try{const r=await fetch('/api/analyze',{method:'POST',headers:HD,body:JSON.stringify({url:u,note:$('anote').value,uid:UID})});const j=await r.json().catch(()=>({}));
    if(!r.ok)$('ares').textContent='⚠️ '+(j.error||('Xato '+r.status));else{$('ares').textContent=j.reply;if(j.models){MODELS_UI=j.models;renderModels()}}}
  catch(e){$('ares').textContent='⚠️ Server bilan aloqa yo‘q'}b.disabled=false;b.textContent='📊 Tahlil qilish'}
renderModels();

const IMGVAR={logo:'--logo',market:'--market',nana:'--ban',kurs:'--kurs',video:'--video',anl:'--anl'};
function applyImgs(m){if(!m)return;for(const k in m){if(IMGVAR[k])document.documentElement.style.setProperty(IMGVAR[k],'url('+m[k]+')')}}
</script>
</body></html>
